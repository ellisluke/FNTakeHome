@if ( YearsAtCompany <= 1 ) {
    yearsClass = "border-new";
}
else if ( YearsAtCompany >= 5) {
    yearsClass = "border-experienced";
}
else {
    yearsClass = "border-medium";
}

<div class="employee-card @yearsClass">
    <img 
        class="employee-image"
        src="@ProfilePicture" 
        onerror="this.src='/images/default.jpg'"
        alt="Headshot of @Name"
    >
    <p>@Name</p>
    <p>@Role</p>
    <p>@Department</p>
    <p>@Email</p>
    <p>@YearsAtCompany</p>
</div>

@code {
    private string yearsClass = "";

    [Parameter]
    public string Name { get; set; }
    
    [Parameter]
    public string Role { get; set; }
    
    [Parameter]
    public string Department { get; set; }
    
    [Parameter]
    public string Email { get; set; }
    
    [Parameter]
    public string ProfilePicture { get; set; }
    
    [Parameter]
    public int YearsAtCompany { get; set; }
}
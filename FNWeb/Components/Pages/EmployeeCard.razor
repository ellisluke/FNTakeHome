@if ( YearsAtCompany <= 1 ) {
    yearsClass = "border-new";
}
else if ( YearsAtCompany >= 5) {
    yearsClass = "border-experienced";
}
else {
    yearsClass = "border-medium";
}

<div class="employee-card @yearsClass" style="--rot-scalar: @randomVar">
    <p class="card-name">@Name</p>
    <p class="card-role">@Role in <strong>@Department</strong></p>

    <img 
        class="employee-image"
        src="/images/@ProfilePicture.Substring(ProfilePicture.LastIndexOf('/'))" 
        onerror="this.src='/images/default.jpg'"
        alt="Headshot of @Name"
        draggable="false"
    >
    <p class="card-email">@Email</p>
    <p class="card-years">@YearsAtCompany years at Example Inc.</p>
</div>

@code {
    private string yearsClass = "";

    [Parameter]
    public string Name { get; set; }
    
    [Parameter]
    public string Role { get; set; }
    
    [Parameter]
    public string Department { get; set; }
    
    [Parameter]
    public string Email { get; set; }
    
    [Parameter]
    public string ProfilePicture { get; set; }
    
    [Parameter]
    public int YearsAtCompany { get; set; }

    protected override void OnInitialized() {
        RandomRotationVar();
    }

    private double randomVar;

    private void RandomRotationVar() {
        Random rand = new Random();

        // generates random double between -1 and 1
        randomVar = (rand.NextDouble() * 2 - 1);
    }
}